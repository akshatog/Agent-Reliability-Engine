# Agent Reliability Engine - Environment Variables

# Database Connection (Asyncpg)
# Format: postgresql+asyncpg://user:password@localhost:5432/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_reliability

# Gemini API Keys (Required for LLM generation and evaluation)
GEMINI_API_KEY=your_google_genai_api_key_here

# Model Selection (Defaults)
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
